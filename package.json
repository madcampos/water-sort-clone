{
	"name": "water-sort-clone",
	"private": true,
	"version": "1.0.0",
	"description": "Clone of https://apps.apple.com/us/app/water-sort-puzzle/id1514542157",
	"type": "module",
	"engines": {
		"node": ">=26.0.0",
		"pnpm": ">=10.26.2"
	},
	"scripts": {
		"start": "vite dev",
		"typecheck": "tsc --noEmit",
		"lint:js": "oxlint --fix",
		"lint": "pnpm run typecheck && pnpm run lint:js",
		"format": "dprint fmt",
		"prepreview": "pnpm run build",
		"preview": "vite preview --port 4000",
		"build": "vite build"
	},
	"license": "MIT",
	"devDependencies": {
		"@types/node": "26.0.1",
		"dprint": "0.55.1",
		"oxlint": "1.72.0",
		"oxlint-tsgolint": "0.24.0",
		"typed-query-selector": "2.12.2",
		"typescript": "6.0.3",
		"vite": "8.1.2",
		"wrangler": "4.106.0"
	},
	"dependencies": {
		"lit": "3.3.3"
	}
}
